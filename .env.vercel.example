# Configure secrets in Vercel; keep real local values in .env.*.local files.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/conferencepoint?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/conferencepoint?sslmode=require
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
BLOB_STORE_ID=provided_by_the_private_vercel_blob_store
BLOB_WEBHOOK_PUBLIC_KEY=provided_by_the_private_vercel_blob_store
NODE_ENV=production
SITE_URL=https://conferencepoint.online
VITE_SITE_URL=https://conferencepoint.online
CLIENT_ORIGINS=https://conferencepoint.online,https://conferencepoint.vercel.app
COOKIE_SAME_SITE=lax
VITE_API_BASE_URL=/
VITE_BLOB_UPLOADS=true
